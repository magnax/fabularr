<%= t('views.location_objects.max_take') %> <%= amount.to_i %> <%= td(unit) %> <%= td("resources.#{key}") %>

<%= form_for :inventory_object, url: inventory_objects_url, method: 'POST' do |form| %>
  <%= form.hidden_field :subject_id, value: subject_id %>
  <%= form.hidden_field :subject_type, value: subject_type %>
  <%= form.text_field :amount %>
  <%= form.submit t('views.location_objects.take') %>
<% end %>