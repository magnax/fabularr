<div class="note-form">
  <%= t('views.notes.new.info') %>
  <%= form_for :note, url: notes_url do |f| %>
    <div>
      <%= f.label :title, t('views.notes.form.title') %>
      <%= f.text_field :title, value: note[:title] %>
    </div>
    <div>
      <%= f.text_area :body, cols: 100, rows: 20, value: note[:body] %>
    </div>
    <div>
      <%= f.submit t('views.notes.form.submit') %>
    </div>
  <% end %>
</div>