<section id="description">
  <div class="title-bar">
    <%= t('views.inventory_objects.eat.title') %>
  </div>
  
  <%= form_for :inventory_object, url: eat_inventory_objects_url, method: 'POST' do |form| %>
    <%= t('views.inventory_objects.eat.amount_label') %>:
    <%= form.hidden_field :subject_id, value: 2 %>
    <%= form.hidden_field :subject_type, value: 'Resource' %>
    <%= form.text_field :amount %>
    <%= form.submit 'Eat' %>
  <% end %>

</section>