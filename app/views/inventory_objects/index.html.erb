<%= t('views.inventory_objects.index.title') %>

<% resources.each do |item| %>
  <div>
    <%= link_to t('views.inventory_objects.index.drop'), inventory_object_drop_url(item[:id]) %>
    <% if item[:edible] || item[:healing] %>
      <%= link_to t('views.inventory_objects.index.eat'), inventory_object_eat_url(item[:id]) %>
    <% end %>
    <%= link_to t('views.inventory_objects.index.add_to_project'), inventory_object_add_url(item[:id]) %>
    
    <%= item[:amount].to_i %> <%= td(item[:unit]) %> <%= td("resources.#{item[:key]}") %></div>
<% end %>
<% items.each do |item| %>
  <div>
    <%= link_to t('views.inventory_objects.index.drop'), inventory_object_drop_item_url(item[:id]) %>
    <%= link_to t('views.inventory_objects.index.add_to_project'), inventory_object_add_url(item[:id]) %>
    
    <%= t("items.damage.#{item[:damage]}") %> <%= t("items.#{item[:key]}") %></div>
<% end %>