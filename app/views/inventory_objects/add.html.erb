<%= t('views.location_objects.add_to_project') %> <%= tn("resources.#{key}") %>
<p><%= t('views.location_objects.have') %>: <%= amount.to_i %> <%= td(unit) %></p>

<%= form_with url: inventory_object_url(inventory_object_id), method: 'PUT' do |form| %>
  <%= form.hidden_field :subject_id, value: subject_id %>
  <%= form.hidden_field :subject_type, value: subject_type %>
  <div>
    <%= form.label :amount, t('views.location_objects.amount') %>
    <%= form.text_field :amount %>
  </div>
  <div>
    <%= form.label :project_id, t('views.location_objects.projects') %>
    <%= form.select :project_id, [['----', 0]] + projects %>
  </div>
  <%= form.submit t('views.location_objects.submit') %>
<% end %>