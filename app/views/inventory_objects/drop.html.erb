<section id="description">
  <div class="title-bar">
    <%= t('views.inventory_objects.drop.title') %> 
  </div>

  <%= t('views.inventory_objects.drop.max_drop') %> <%= amount.to_i %> <%= td(unit) %> <%= td("resources.#{key}") %>

  <%= form_for :location_object, url: location_objects_url, method: 'POST' do |form| %>
    <%= form.hidden_field :subject_id, value: subject_id %>
    <%= form.hidden_field :subject_type, value: subject_type %>
    <%= form.text_field :amount %>
    <%= form.submit t('views.inventory_objects.drop.submit') %>
  <% end %>
</section>