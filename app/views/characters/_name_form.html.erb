<%= t 'views.characters.name.current_name' %>: <%= charname[:name] %>
<%= form_for(:char_name, url: char_names_url, method: 'POST') do |f| %>
  <%= f.hidden_field :named_id, value: charname[:char_id] %>

  <%= f.label :name, t('views.characters.name.new_name') %>
  <%= f.text_field :name, value: charname[:name] %>

  <%= f.label :description %>
  <%= f.text_field :description %>

  <%= f.submit I18n.t 'views.characters.name.create', data: { disable_with: false }, class: "btn btn-large btn-primary" %>
<% end %>