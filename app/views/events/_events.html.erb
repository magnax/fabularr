<%= form_for(:event) do |f| %>

  <%= f.text_area :body, id: 'submit-body', rows: 1, cols: 80 %>
  <%= f.submit t('views.events.send'), data: { disable_with: false }, 
    class: "submit-button btn btn-large btn-primary" 
  %>

<% end %>
<section id="event-list" style="height: 16em; overflow: auto;">
  <% events.each do |event| %>
    <div class="event">
      <span class="event-date">
        <%= event[:created_at] %>
      </span>
      <span>
        <%= event[:body].html_safe %>
      </span>
    </div>
  <% end %>
</section>
