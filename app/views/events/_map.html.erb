<section id="map"  style="float:right;width:29%;margin-left:3px;margin-bottom:6px;">
  <div class="title-bar">
    <%= t 'views.events.index.roads_here' %>
  </div>
  <% if location && location[:seashore] %>
    <%= t('locations.borders_sea') %>
  <% end %>
  <% if location && location[:lakeshore] %>
    <%= t('locations.borders_lake') %>
  <% end %>
  <img src="/maps" width=200 height=200>

  <% if location[:ship] %>
    <div>
      <% if travel_info.present? %>
        <% if travel_info[:speed].zero? %>
          <%= t('views.events.index.floating') %>
        <% else %>
          <%= t('views.events.index.sailing', 
                direction: travel_info[:direction], 
                speed: travel_info[:speed]) 
          %>
        <% end %>
        <br />
        <%= form_for :traveller, url: traveller_url(travel_info[:traveller_id]), method: 'PUT' do |form| %>
          <%= t('views.travellers.update.direction') %> <%= form.text_field :direction, value: travel_info[:direction] || '0', style: 'width:3em;' %>
          <%= t('views.travellers.update.speed') %> <%= form.text_field :speed, value: travel_info[:speed], style: 'width:3em;' %>%
          <%= form.submit t('views.travellers.update.submit') %>
        <% end %>
      <% else %>
          <%= link_to t('views.events.index.undock'), location_undock_url(location[:id]), class: 'char-action' %>
      <% end %>
    </div>
  <% end %>
</section>