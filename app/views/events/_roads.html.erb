<% if roads.present? %>
  <% roads.each do |road| %>
    <div>
      <%= link_to fa_icon('hand-o-right'), point_road_url(road[:id]), title: t('roads.actions.point') %>
      <span>
        <%= t('views.roads.name_html', type: road[:type], location_link: link_to(road[:location_name], location_name_url(road[:location_id])), direction: road[:direction]) %>
      </span>
      <%= link_to fa_icon('road', title: 'Road'), travellers_url(traveller: { road_id: road[:id] }), method: :post %>
    </div>
  <% end %>
<% end %>